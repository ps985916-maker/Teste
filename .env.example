import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from modulo_analise_ia.analisador import Analise, AnalisadorIA
from modulo_motor_decisao.motor import MotorDecisao, Sinal
from modulo_gestao_risco.risco import GestorRisco, AprovacaoRisco
from shared.config import Config


class DummyBanco:
    def registrar_mercado(self, *args, **kwargs):
        pass

    def registrar_sinal(self, *args, **kwargs):
        pass

    def registrar_validacao(self, *args, **kwargs):
        pass

    def registrar_ordem(self, *args, **kwargs):
        pass

    def registrar_metricas(self, *args, **kwargs):
        pass


class DummyConfig:
    trading_mode = "SIMULACAO"
    max_capital_per_trade = 0.02
    max_daily_loss = 0.03
    max_weekly_loss = 0.07
    max_stop_loss_pct = 0.03
    max_volatility_pct = 0.10
    min_confidence = 0.65


def test_motor_decisao_emite_sinal_valido():
    cfg = DummyConfig()
    motor = MotorDecisao(cfg)
    analise = Analise(
        symbol="BTC/USDT",
        sentiment=0.8,
        confidence=0.9,
        technical_score=0.7,
        positive_factors=["MACD positivo"],
        negative_factors=[],
        volatility=0.03,
        data_sufficient=True,
    )
    sinal = motor.gerar_sinal("BTC/USDT", analise)
    assert sinal.action == "COMPRAR"
    assert sinal.confidence >= 0.65


def test_gestor_risco_aprova_via_segura():
    cfg = DummyConfig()
    risco = GestorRisco(cfg, DummyBanco())
    sinal = Sinal("ETH/USDT", "COMPRAR", 0.9, ["fator positivo"], 0.02)
    mercado = {"ticker": {"last": 3000.0}, "candles": list(range(30)), "volatility": 0.03}
    aprovacao = risco.validar(sinal, mercado, 10000.0)
    assert aprovacao.aprovado is True


def test_config_default_works():
    cfg = Config.from_env()
    assert cfg.trading_mode in {"SIMULACAO", "REAL"}
    assert isinstance(cfg.symbols, list)
