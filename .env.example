# Credenciais (preencha apenas no arquivo .env local)
LLM_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Configuração segura: simulação é o único modo habilitado inicialmente
TRADING_MODE=SIMULACAO
EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
POLL_INTERVAL_SECONDS=300
DATABASE_PATH=data/trading_agent.sqlite3
LOG_LEVEL=INFO

# Limites de risco (percentuais em formato decimal)
MAX_CAPITAL_PER_TRADE=0.02
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.07
MAX_STOP_LOSS_PCT=0.03
MAX_VOLATILITY_PCT=0.10
MIN_CONFIDENCE=0.65

# Provedor de LLM opcional; sem chave, o sistema usa fallback neutro
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
NEWS_BASE_URL=https://newsapi.org/v2/everything
